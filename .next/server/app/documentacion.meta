{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/documentacion/layout,_N_T_/documentacion/page,_N_T_/documentacion"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/documentacion/__PAGE__",
    "/documentacion",
    "/_index",
    "/_head"
  ]
}